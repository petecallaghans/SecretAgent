# Auth handled by Claude Code — run `claude login` first
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
ALLOWED_USERS=123456789,987654321
MODEL=claude-sonnet-4-5
MAX_TOKENS=8192
WORKSPACE_DIR=./workspace
DATA_DIR=./data
SHELL_ALLOWLIST=
WEBHOOK_PORT=3000

# --- Multi-agent collaboration (optional) ---
# Shared bearer secret for the peer channel. Same value on every instance in the team.
PEER_SECRET=
# Max agent-to-agent hops before a chain halts and asks for a human (default 8).
MAX_HOPS=8
# Roster is normally workspace/roster.json. Alternatively inline its JSON here:
# PEER_ROSTER={"self":"alice","groupChatId":"-100...","sharedSecret":"env:PEER_SECRET","peers":[...]}
